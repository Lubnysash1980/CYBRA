diff --git a/bin/cybra-pm b/bin/cybra-pm
index fc39fdb..f766356 100755
--- a/bin/cybra-pm
+++ b/bin/cybra-pm
@@ -5,7 +5,26 @@ G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; B=$'\e[36m'; D=$'\e[2m'; N=$'\e[0m'
 
 case "${1:-list}" in
   list|ls|status)
-    python3 "$S" list
+    python3 - <<'PYL'
+import json
+from pathlib import Path
+cfg = json.loads((Path.home()/"CYBRA/config/pm_processes.json").read_text())
+G='\033[32m'; Y='\033[33m'; B='\033[36m'; D='\033[2m'; N='\033[0m'
+# Спершу — базовий list
+import subprocess
+r = subprocess.run(["python3", str(Path.home()/"CYBRA/modules/module_300_pm/supervisor.py"), "list"],
+                  capture_output=True, text=True)
+print(r.stdout, end="")
+# Потім — таблиця modes
+print(f"\n{B}Mode summary:{N}")
+from collections import Counter
+c = Counter(p.get("mode", "daemon") for p in cfg["processes"].values())
+for mode in ["daemon", "interval", "ondemand"]:
+    n = c.get(mode, 0)
+    if n:
+        col = {"daemon":G, "interval":Y, "ondemand":D}[mode]
+        print(f"  {col}{mode:10s}{N} {n}")
+PYL
     ;;
   start-all)
     python3 "$S" start-all
