diff --git a/modules/module_114_autonode/daemon.py b/modules/module_114_autonode/daemon.py
index a39c098..cf2a9a4 100755
--- a/modules/module_114_autonode/daemon.py
+++ b/modules/module_114_autonode/daemon.py
@@ -2,6 +2,77 @@
 import json, os, sys, time, signal, datetime, threading
 from datetime import timezone
 import urllib.request, urllib.error
+import threading
+import email.utils
+import fcntl
+from urllib.parse import urlsplit
+
+# API controller: per-host spacing + bounded 429/503 retries.
+_API_MIN_INTERVAL = 1.0
+_API_MAX_RETRIES = 2
+_API_RETRY_MAX_SEC = 10.0
+_api_lock = threading.Lock()
+_api_host_last = {}
+
+def _api_retry_after(value):
+    if not value:
+        return None
+    try:
+        return max(0.0, min(float(value), _API_RETRY_MAX_SEC))
+    except (TypeError, ValueError):
+        pass
+    try:
+        dt = email.utils.parsedate_to_datetime(value)
+        return max(0.0, min(dt.timestamp() - time.time(),
+                            _API_RETRY_MAX_SEC))
+    except Exception:
+        return None
+
+def _urlopen_limited(req, timeout=10):
+    host = (urlsplit(req.full_url).hostname or "").lower()
+    attempt = 0
+    while True:
+        # Serialize calls within this process and space requests per host.
+        with _api_lock:
+            now = time.monotonic()
+            previous = _api_host_last.get(host, 0.0)
+            wait = _API_MIN_INTERVAL - (now - previous)
+            if wait > 0:
+                time.sleep(wait)
+            _api_host_last[host] = time.monotonic()
+
+        try:
+            return urllib.request.urlopen(req, timeout=timeout)
+        except urllib.error.HTTPError as exc:
+            if exc.code not in (429, 503) or attempt >= _API_MAX_RETRIES:
+                raise
+            retry_after = _api_retry_after(exc.headers.get("Retry-After"))
+            delay = retry_after if retry_after is not None else min(
+                2 ** attempt, _API_RETRY_MAX_SEC
+            )
+            try:
+                exc.close()
+            except Exception:
+                pass
+            attempt += 1
+            time.sleep(delay)
+
+def _acquire_instance_lock():
+    os.makedirs(RUN_DIR, exist_ok=True)
+    lock_path = os.path.join(RUN_DIR, "autonode.instance.lock")
+    lock_file = open(lock_path, "a+")
+    try:
+        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError:
+        log("API_CONTROLLER: another AutoNode instance holds the lock; exiting")
+        lock_file.close()
+        return None
+    lock_file.seek(0)
+    lock_file.truncate()
+    lock_file.write(str(os.getpid()) + "\\n")
+    lock_file.flush()
+    return lock_file
+
 
