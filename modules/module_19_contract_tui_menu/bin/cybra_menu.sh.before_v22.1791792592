  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[200]${C_RESET} network"
  echo
  echo "  ${C_GREY}🟢 ready  🟡 warning  🔴 error${C_RESET}"
  echo
  echo "  [0]  Вихід"
