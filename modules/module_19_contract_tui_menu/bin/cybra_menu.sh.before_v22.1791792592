#!/data/data/com.termux/files/usr/bin/bash
# CYBRA CONTRACT MANAGER — TUI v2.1
set -uo pipefail

H="$HOME/CYBRA"; M="$H/modules"
B=$'\e[36m'; C_BOLD=$'\e[1m'; C_GREY=$'\e[90m'
C_RESET=$'\e[0m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'

menu(){
  clear
  echo "${B}${C_BOLD}════════════════════════════════════════════════════════════${C_RESET}"
  echo "${B}${C_BOLD}  CYBRA CONTRACT MANAGER — TUI v2.1${C_RESET}   $(date -u +'%Y-%m-%d %H:%M UTC')"
  echo "${B}${C_BOLD}════════════════════════════════════════════════════════════${C_RESET}"
  echo
  echo "  ${B}─── METAMASK ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[108] metamask_sign          ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[109] metamask_verify]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[110] metamask_history       ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[111] metamask_settings]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[112] metamask_deeplink      ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[113] metamask_batch]${C_RESET}\n"
  echo
  echo "  ${B}─── AUTONODE ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[114] autonode               ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[115] rpc_bench]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[116] gas_monitor            ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[117] tx_lookup]${C_RESET}\n"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[118]${C_RESET} net_health"
  echo
  echo "  ${B}─── QR SIGN (9 рівнів) ───${C_RESET}"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[119]${C_RESET} qr_sign"
  echo
  echo "  ${B}─── AI GUARDIAN ───${C_RESET}"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[120]${C_RESET} ai_guardian"
  echo
  echo "  ${B}─── PARLIAMENT ───${C_RESET}"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[121]${C_RESET} parlament"
  echo
  echo "  ${B}─── VALIDATOR ───${C_RESET}"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[122]${C_RESET} contract_validator"
  echo
  echo "  ${B}─── MULTISIG ───${C_RESET}"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[123]${C_RESET} multisig"
  echo
  echo "  ${B}─── CRYPTO ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[124] timelock               ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[125] anchor]${C_RESET}\n"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[126]${C_RESET} zk"
  echo
  echo "  ${B}─── UI / TOOLS ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[128] dashboard              ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[129] voice]${C_RESET}\n"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[130]${C_RESET} test_suite"
  echo
  echo "  ${B}─── INTEGRATIONS+ ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[131] kyc                    ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[132] compliance]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[133] tokens                 ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[134] discord]${C_RESET}\n"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[135]${C_RESET} walletconnect"
  echo
  echo "  ${B}─── ESCROW / ARBITRATION ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[136] templates              ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[137] escrow]${C_RESET}\n"
  echo "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[138]${C_RESET} arbitration"
  echo
  echo "  ${B}─── REPUTATION / ANALYTICS ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[139] reputation             ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[140] analytics]${C_RESET}\n"
  echo
  echo "  ${B}─── ADVANCED ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[141] portfolio              ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[142] invoice_pdf]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[143] email                  ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[144] lightning]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[145] ipfs                   ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[146] merkle]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[147] reputation_v2          ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[148] multisig_ui]${C_RESET}\n"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[149] analytics              ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[150] scripts]${C_RESET}\n"
  echo
  echo "  ${B}─── ONBOARDING ───${C_RESET}"
  printf "  ${C_GREY}🟢${C_RESET} ${C_BOLD}[151] wizard                 ${C_RESET}${C_GREY}🟢${C_RESET} ${C_BOLD}[152] doctor]${C_RESET}\n"
  echo
