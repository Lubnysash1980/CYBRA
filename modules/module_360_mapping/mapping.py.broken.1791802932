# ═══════════════════════════════════════════════════════════════
# BUILD + SAVE
# ═══════════════════════════════════════════════════════════════
def build():
    """Генерує mapping.json з базової карти + сканує диску."""
    mapping = {}
    for item_id, cfg in CORE_MAPPING.items():
        path = None
        # знайти модуль на диску
        for d in M.glob(f"module_{item_id.zfill(3)}_*") + M.glob(f"module_{item_id}_*"):
            path = d.name
            break
        mapping[item_id] = {
            "id": item_id,
            "slug": cfg["slug"],
            "path": path or f"builtin:{cfg['slug']}",
            "priority": cfg["priority"],
            "controllers": cfg["ctrl"],
            "heal_action": cfg["heal"],
            "parliament_role": cfg["parl"],
            "builtin": path is None,
            "mapped_at": _now(),
        }
    # версія
    out = {"version": "1.0", "built": _now(),
           "total": len(mapping), "items": mapping}
    MAP_FILE.write_text(json.dumps(out, indent=2, ensure_ascii=False))
    return out

def load():
    if not MAP_FILE.exists(): return build()
    try: return json.loads(MAP_FILE.read_text())
    except Exception: return build()

# ═══════════════════════════════════════════════════════════════
# API для Worker / Parliament
# ═══════════════════════════════════════════════════════════════
def get(item_id):
    return load()["items"].get(str(item_id))

def by_controller(ctrl_name):
    """Всі пункти що прив'язані до контролера."""
    items = load()["items"]
    return [it for it in items.values() if ctrl_name in it["controllers"]]

def by_priority(p):
    """Пункти з пріоритетом p."""
    items = load()["items"]
    return [it for it in items.values() if it["priority"] == p]

def critical():
    """Критичні пункти (p=1)."""
    return by_priority(1)

def heal_plan(item_id):
    """План лікування для пункту."""
    it = get(item_id)
    if not it: return None
    return {
        "item": item_id,
        "slug": it["slug"],
        "priority": it["priority"],
        "controllers": it["controllers"],
        "heal": it["heal_action"],
        "parliament": it["parliament_role"],
    }

def worker_report():
    """Звіт для worker — які контролери що перевіряють + пріоритети."""
    items = load()["items"]
    by_ctrl = {}
    for it in items.values():
        for c in it["controllers"]:
            by_ctrl.setdefault(c, []).append({
                "id": it["id"], "slug": it["slug"],
                "priority": it["priority"], "heal": it["heal_action"]
            })
    return {"by_controller": by_ctrl, "total_items": len(items)}

def parliament_report():
    """Звіт для парламенту — що голосувати."""
    items = load()["items"]
    by_role = {"auto": [], "vote": [], "veto": [], "manual": []}
    for it in items.values():
        by_role.setdefault(it["parliament_role"], []).append({
            "id": it["id"], "slug": it["slug"], "priority": it["priority"],
            "controllers": it["controllers"]
        })
    return by_role

# ═══════════════════════════════════════════════════════════════
# CLI
# ═══════════════════════════════════════════════════════════════
if __name__ == "__main__":
    import sys
    G='\033[32m'; Y='\033[33m'; R='\033[31m'; B='\033[36m'; D='\033[2m'; BOLD='\033[1m'; N='\033[0m'
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"

    if cmd == "build":
        out = build()
        print(f"  {G}✓{N} mapping: {out['total']} пунктів")

    elif cmd == "list":
        items = load()["items"]
        for p in [1, 2, 3, 4, 5]:
            group = [it for it in items.values() if it["priority"] == p]
            if not group: continue
            col = [R, Y, B, D, D][p-1]
            print(f"\n  {col}P{p}{N} ({len(group)}):")
            for it in sorted(group, key=lambda x: int(x["id"])):
                ctrls = ",".join(it["controllers"][:3])
                print(f"    [{it['id']:>3}] {it['slug']:22s} {D}{ctrls:30s} heal={it['heal_action']}{N}")

    elif cmd == "show":
        item = get(sys.argv[2])
        if item: print(json.dumps(item, indent=2, ensure_ascii=False))
        else: print(f"  ✗ немає пункту {sys.argv[2]}")

    elif cmd == "ctrl":
        c = sys.argv[2]
        items = by_controller(c)
        print(f"\n  {B}Контролер {c}: {len(items)} пунктів{N}")
        for it in items:
            print(f"    [{it['id']:>3}] P{it['priority']} {it['slug']}")

    elif cmd == "worker":
        print(json.dumps(worker_report(), indent=2, ensure_ascii=False))

    elif cmd == "parliament":
        r = parliament_report()
        for role in ["veto", "vote", "auto", "manual"]:
            if r.get(role):
                col = {"veto":R, "vote":Y, "auto":G, "manual":D}[role]
                print(f"\n  {col}{role.upper()}{N} ({len(r[role])}):")
                for it in r[role][:10]:
                    print(f"    [{it['id']:>3}] P{it['priority']} {it['slug']}")

    elif cmd == "heal":
        plan = heal_plan(sys.argv[2])
        if plan: print(json.dumps(plan, indent=2, ensure_ascii=False))

    elif cmd == "json":
        print(json.dumps(load(), indent=2, ensure_ascii=False))
