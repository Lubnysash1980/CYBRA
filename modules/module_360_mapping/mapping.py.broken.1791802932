#!/usr/bin/env python3
"""Mapping Controller — карта всіх пунктів → контролери → дії.

Кожен пункт меню має:
  · id, slug, path      — де знаходиться
  · controllers[]        — які контролери його перевіряють
  · priority             — критичність (1=critical, 5=low)
  · heal_action          — як лікувати
  · parliament_role      — як парламент впливає (vote/veto/auto)
  · deps[]               — залежності
"""
import json, os, sys, time
from pathlib import Path

H = Path.home() / "CYBRA"
M = H / "modules"
D = Path(__file__).resolve().parent
MAP_FILE = D / "data" / "mapping.json"

def _now(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

