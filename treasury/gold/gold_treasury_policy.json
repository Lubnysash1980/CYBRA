{
  "name": "CYBRA Gold Treasury Policy",
  "status": "proposal_only",
  "unit": "XAU",
  "purpose": "Вести облік пропозицій конвертації вартості у золото як treasury accounting unit.",
  "rules": {
    "automatic_gold_purchase": false,
    "automatic_conversion": false,
