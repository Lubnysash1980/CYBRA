#!/usr/bin/env bash
cd "$HOME/CYBRA" || exit 1

case "$1" in
  status|run|"")
    python3 scripts/monitor/cybra_redis_load_monitor.py status
    ;;
  json)
    python3 scripts/monitor/cybra_redis_load_monitor.py json
    ;;
  proof)
    python3 scripts/monitor/cybra_redis_load_monitor.py proof
    ;;
  serve)
    python3 -m http.server 8795 --bind 127.0.0.1 --directory dashboard/cybra_load_monitor
    ;;
  *)
    echo "Commands:"
    echo "  cybra-load status"
    echo "  cybra-load json"
    echo "  cybra-load proof"
    echo "  cybra-load serve"
    ;;
esac
