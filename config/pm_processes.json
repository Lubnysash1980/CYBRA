{
  "supervisor": {
    "check_interval_sec": 30,
    "max_restart_per_hour": 20,
    "restart_delay_sec": 10
  },
  "processes": {
    "autonode": {
      "name": "autonode",
      "desc": "AutoNode — multi-chain RPC watcher",
      "cmd": "python3 $HOME/CYBRA/modules/module_114_autonode/daemon.py",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/autonode.pid",
      "log_file": "$HOME/CYBRA/logs/autonode.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "module_114_autonode/daemon.py"
    },
    "watchdog": {
      "name": "watchdog",
      "desc": "Parliament watchdog — evolve + completion + sync",
      "cmd": "bash $HOME/CYBRA/modules/module_121_parlament/watchdog.sh daemon",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_watchdog.pid",
      "log_file": "$HOME/CYBRA/logs/parlament.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "parlament/watchdog.sh daemon"
    },
    "orchestrator": {
      "name": "orchestrator",
      "desc": "Orchestrator — auto-install + integrate + monitor",
      "cmd": "python3 $HOME/CYBRA/modules/module_121_parlament/orchestrator.py daemon --interval 600",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_orchestrator.pid",
      "log_file": "$HOME/CYBRA/logs/orch.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "orchestrator.py daemon",
      "_phone_disabled": true
    },
    "supervisor": {
      "name": "supervisor",
      "desc": "PM supervisor — сам стежить за всіма процесами",
      "cmd": "python3 $HOME/CYBRA/modules/module_300_pm/supervisor.py loop",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_supervisor.pid",
      "log_file": "$HOME/CYBRA/logs/pm.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "module_300_pm/supervisor.py loop"
    },
    "dashboard": {
      "name": "dashboard",
      "desc": "Web Dashboard — HTTP panel (SSE)",
      "cmd": "python3 $HOME/CYBRA/modules/module_128_dashboard/server.py 8790",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_dashboard.pid",
      "log_file": "$HOME/CYBRA/logs/dashboard.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_128_dashboard/server.py",
      "_phone_disabled": true
    },
    "selfheal": {
      "name": "selfheal",
      "desc": "Self-Heal Engine — авто-відновлення системи",
      "cmd": "python3 $HOME/CYBRA/modules/module_330_selfheal/engine.py daemon 900",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_selfheal.pid",
      "log_file": "$HOME/CYBRA/logs/selfheal.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "module_330_selfheal/engine.py daemon"
    },
    "controller_worker": {
      "name": "controller_worker",
      "desc": "Controller Worker — цикл контролерів + автолікування",
      "cmd": "python3 $HOME/CYBRA/modules/module_350_controller_worker/worker.py daemon 300",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_controller_worker.pid",
      "log_file": "$HOME/CYBRA/logs/controller_worker.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_350_controller_worker/worker.py daemon",
      "_phone_disabled": true
    },
    "runtime": {
      "name": "runtime",
      "desc": "Runtime — паралельні задачі",
      "cmd": "python3 $HOME/CYBRA/modules/module_370_runtime/runtime.py daemon 3",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_runtime.pid",
      "log_file": "$HOME/CYBRA/logs/runtime.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_370_runtime/runtime.py daemon",
      "_phone_disabled": true
    },
    "job_controller": {
      "name": "job_controller",
      "desc": "Job Controller — failover runtime→binmixer",
      "cmd": "python3 $HOME/CYBRA/modules/module_371_job_controller/controller.py daemon 30",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_job_controller.pid",
      "log_file": "$HOME/CYBRA/logs/job_controller.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_371_job_controller/controller.py daemon",
