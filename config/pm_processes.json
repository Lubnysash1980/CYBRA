      "cmd": "python3 $HOME/CYBRA/modules/module_390_src/src.py daemon 600",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_src.pid",
      "log_file": "$HOME/CYBRA/logs/src.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_390_src/src.py daemon",
      "_phone_disabled": true
    },
    "structure": {
      "name": "structure",
      "desc": "Structure Guardian — карта структури",
      "cmd": "python3 $HOME/CYBRA/modules/module_395_structure/daemon.py",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_structure.pid",
      "log_file": "$HOME/CYBRA/logs/structure.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_395_structure",
      "_phone_disabled": true
    },
    "diffrecover": {
      "name": "diffrecover",
      "desc": "Snapshot Diff Recovery — посимвольне",
      "cmd": "python3 $HOME/CYBRA/modules/module_396_diffrecover/daemon.py",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_diffrecover.pid",
      "log_file": "$HOME/CYBRA/logs/diffrecover.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_396_diffrecover",
      "_phone_disabled": true
    },
    "load": {
      "name": "load",
      "desc": "Load Controller — балансування",
      "cmd": "python3 $HOME/CYBRA/modules/module_397_load/load.py daemon 60",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_load.pid",
      "log_file": "$HOME/CYBRA/logs/load.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_397_load",
      "_phone_disabled": true
    },
    "webui": {
      "name": "webui",
      "desc": "Web UI — простий стан",
      "cmd": "python3 $HOME/CYBRA/modules/module_398_webui/server.py 8791",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_webui.pid",
      "log_file": "$HOME/CYBRA/logs/webui.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_398_webui/server.py",
      "_phone_disabled": true
    },
    "task_engine": {
      "name": "task_engine",
      "desc": "Task Engine — двигун задач з sandbox-тестом",
      "cmd": "bash $HOME/CYBRA/modules/module_405_task_engine/cron.sh",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_task_engine.pid",
      "log_file": "$HOME/CYBRA/logs/task_engine.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_405_task_engine/cron.sh",
      "_phone_disabled": true
    },
    "tui_guard": {
      "name": "tui_guard",
      "desc": "TUI Integrity Guard — тримає TUI синхронізованим",
      "cmd": "python3 $HOME/CYBRA/modules/module_406_tui_guard/guard.py daemon",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_tui_guard.pid",
      "log_file": "$HOME/CYBRA/logs/tui_guard.log",
      "auto_restart": false,
      "enabled": false,
      "match_pattern": "module_406_tui_guard/guard.py daemon",
      "_phone_disabled": true
    }
  }
}