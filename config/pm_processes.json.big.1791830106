{
  "supervisor": {
    "check_interval_sec": 30,
    "max_restart_per_hour": 20,
    "restart_delay_sec": 10
  },
  "processes": {
    "autonode": {
      "name": "autonode",
      "desc": "AutoNode — multi-chain RPC watcher",
      "cmd": "python3 $HOME/CYBRA/modules/module_114_autonode/daemon.py",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/autonode.pid",
      "log_file": "$HOME/CYBRA/logs/autonode.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "module_114_autonode/daemon.py",
      "mode": "daemon"
    },
    "watchdog": {
      "name": "watchdog",
      "desc": "Parliament watchdog — evolve + completion + sync",
      "cmd": "bash $HOME/CYBRA/modules/module_121_parlament/watchdog.sh daemon",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_watchdog.pid",
      "log_file": "$HOME/CYBRA/logs/parlament.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "parlament/watchdog.sh daemon",
      "env": {
        "PARLAMENT_INTERVAL": "1800"
      },
      "mode": "daemon"
    },
    "orchestrator": {
      "name": "orchestrator",
      "desc": "Orchestrator — auto-install + integrate + monitor",
      "cmd": "python3 $HOME/CYBRA/modules/module_121_parlament/orchestrator.py daemon --interval 600",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_orchestrator.pid",
      "log_file": "$HOME/CYBRA/logs/orch.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "orchestrator.py daemon",
      "mode": "daemon"
    },
    "supervisor": {
      "name": "supervisor",
      "desc": "PM supervisor — сам стежить за всіма процесами",
      "cmd": "python3 $HOME/CYBRA/modules/module_300_pm/supervisor.py loop",
      "cwd": "$HOME/CYBRA",
      "pid_file": "$HOME/CYBRA/run/pm_supervisor.pid",
      "log_file": "$HOME/CYBRA/logs/pm.log",
      "auto_restart": true,
      "enabled": true,
      "match_pattern": "module_300_pm/supervisor.py loop",
      "mode": "daemon"
    },
    "dashboard": {
