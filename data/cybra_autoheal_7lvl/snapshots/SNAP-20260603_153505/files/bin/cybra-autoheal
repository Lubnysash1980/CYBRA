        "levels": LEVELS,
        "repairs": "AUTOHEAL_BETA",
        "created_at": time.time(),
        "created_at_iso": now_iso()
    }
    alpha["double_sha"] = dsha(json.dumps(alpha, ensure_ascii=False, sort_keys=True))

    beta = {
        "system_id": "AUTOHEAL_BETA",
        "role": "repair_alpha",
        "status": "active",
        "levels": LEVELS,
        "repairs": "AUTOHEAL_ALPHA",
        "created_at": time.time(),
        "created_at_iso": now_iso()
    }
    beta["double_sha"] = dsha(json.dumps(beta, ensure_ascii=False, sort_keys=True))

    dispatcher = {
        "system_id": "SEAL_DISPATCHER",
        "role": "task_distribution_and_seal",
        "status": "active",
        "flow": [
            "health_check",
