    save_json("data/cybra_autoheal_7lvl/levels.json", {"levels": LEVELS})

def redis_ping():
    code, out, err = run(["redis-cli", "ping"])
    return code == 0 and out == "PONG"

def start_redis():
    if redis_ping():
        return True
    run(["redis-server", "--daemonize", "yes", "--bind", "127.0.0.1", "--port", "6379", "--dir", str(ROOT / "runtime/redis"), "--save", "", "--appendonly", "no"])
    time.sleep(1)
    return redis_ping()

def health():
    init()
    start_redis()

    checks = {
        "redis_ping": redis_ping(),
        "redis_committee": exists("cybra_redis_committee.sh"),
        "cybra_finance_bin": exists("bin/cybra-finance-bin"),
        "cybra_autoheal_bin": exists("bin/cybra-autoheal"),
        "payment_requisites": exists("cybra_payment_requisites.sh"),
        "kybra_valid": exists("kybra_valid.sh"),
        "finance_committees": exists("cybra_finance_committees.sh"),
        "market_collector": exists("cybra_market_proof_collector.sh"),
        "price_gate": exists("cybra_real_market_price_gate.sh"),
        "closed_sha_bridge": exists("cybra_closed_sha_bridge.sh"),
        "kibra_stats": exists("cybra_kibra_stats.sh"),
        "cold_finance_report": exists("feeds/cybra_cold_finance_binary_report.json"),
        "kybra_valid_report": exists("feeds/kybra_valid_wallet_gateway_report.json"),
        "payment_requisites_report": exists("feeds/cybra_payment_requisites_package.json"),
        "five_committees_report": exists("feeds/cybra_finance_5_committees_report.json"),
        "autoheal_report": exists("feeds/cybra_autoheal_7lvl_report.json"),
        "parliament_failed_zero": redis_len("cybra:parliament:failed") == 0
    }

    level_status = []
    for level in LEVELS:
        bad = []
        if level["id"] == "L1_REDIS_HEALTH":
            if not checks["redis_ping"]:
                bad.append("redis_ping")
        if level["id"] == "L2_BINARY_HEALTH":
            if not checks["cybra_finance_bin"]:
                bad.append("cybra_finance_bin")
            if not checks["cybra_autoheal_bin"]:
                bad.append("cybra_autoheal_bin")
        if level["id"] == "L3_FINANCE_DATA_HEALTH":
            if not checks["cold_finance_report"]:
                bad.append("cold_finance_report")
            if not checks["payment_requisites_report"]:
                bad.append("payment_requisites_report")
        if level["id"] == "L4_WALLET_REQUISITES_HEALTH":
            if not checks["kybra_valid"]:
                bad.append("kybra_valid")
            if not checks["kybra_valid_report"]:
                bad.append("kybra_valid_report")
        if level["id"] == "L5_PARLIAMENT_TASK_HEALTH":
            if not checks["closed_sha_bridge"]:
                bad.append("closed_sha_bridge")
            if not checks["parliament_failed_zero"]:
                bad.append("parliament_failed_not_zero")
        if level["id"] == "L6_MARKET_SAFETY_HEALTH":
            if not checks["price_gate"]:
                bad.append("price_gate")
            if not checks["market_collector"]:
                bad.append("market_collector")
        if level["id"] == "L7_SEAL_DISPATCHER_HEALTH":
            if not checks["autoheal_report"]:
                bad.append("autoheal_report_first_run_or_missing")

        level_status.append({
            "level": level["id"],
            "name": level["name"],
            "ok": len(bad) == 0,
            "bad": bad
        })

    obj = {
        "status": "health_checked",
        "time": time.time(),
        "time_iso": now_iso(),
        "checks": checks,
        "levels": level_status,
        "queues": {
            "repair_queue": redis_len(REPAIR_Q),
            "seal_queue": redis_len(SEAL_Q),
            "block_inbox": redis_len(AI_BLOCK_INBOX),
            "task_block_mempool": redis_len("cybra:kibra:task_blocks:mempool"),
            "pool_mining_blocks": redis_len("cybra:kibra:pool:mining_blocks"),
            "parliament_queue": redis_len("cybra:parliament:queue"),
            "parliament_failed": redis_len("cybra:parliament:failed")
        },
        "safety": {
            "private_keys": False,
            "seed_phrase": False,
            "automatic_real_payment": False,
            "automatic_external_tx": False,
            "manual_OWNER_approval_required": True
        }
    }
    obj["ok"] = all(x["ok"] for x in level_status if x["level"] != "L7_SEAL_DISPATCHER_HEALTH")
    obj["double_sha"] = dsha(json.dumps(obj, ensure_ascii=False, sort_keys=True))

    save_json("data/cybra_autoheal_7lvl/reports/health.json", obj)
    return obj

def snapshot():
    init()
    snap_id = "SNAP-" + time.strftime("%Y%m%d_%H%M%S")
    snap_dir = DATA / "snapshots" / snap_id
    snap_dir.mkdir(parents=True, exist_ok=True)

    manifest = {
        "snapshot_id": snap_id,
        "time": time.time(),
        "time_iso": now_iso(),
        "files": {},
        "dirs": {},
        "safety": {
            "private_keys": False,
            "seed_phrase": False
        }
    }

    for rel in WATCH_FILES:
        src = ROOT / rel
        if src.exists() and src.is_file():
            dst = snap_dir / "files" / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            manifest["files"][rel] = file_sha(rel)

    for rel in WATCH_DIRS:
        src = ROOT / rel
        if src.exists() and src.is_dir():
            dst = snap_dir / "dirs" / rel
            if dst.exists():
                shutil.rmtree(dst)
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(src, dst, dirs_exist_ok=True)
            manifest["dirs"][rel] = "copied"

    manifest["double_sha"] = dsha(json.dumps(manifest, ensure_ascii=False, sort_keys=True))
    save_json(f"data/cybra_autoheal_7lvl/snapshots/{snap_id}/manifest.json", manifest)
    save_json("data/cybra_autoheal_7lvl/snapshots/latest_snapshot.json", manifest)

    redis_lpush(AUDIT, {
        "status": "snapshot_created",
        "snapshot_id": snap_id,
        "double_sha": manifest["double_sha"],
        "time": manifest["time"]
    })

    print("✅ snapshot created")
    print("SNAPSHOT:", snap_id)
    print("DOUBLE_SHA:", manifest["double_sha"])

def latest_snapshot_dir():
    latest = load_json("data/cybra_autoheal_7lvl/snapshots/latest_snapshot.json", {})
    sid = latest.get("snapshot_id")
    if not sid:
        return None
    p = DATA / "snapshots" / sid
    if p.exists():
        return p
    return None

def restore_missing_from_snapshot():
    snap = latest_snapshot_dir()
    if not snap:
        return []

    restored = []

    for rel in WATCH_FILES:
        dst = ROOT / rel
        src = snap / "files" / rel
        if src.exists() and not dst.exists():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            try:
                dst.chmod(dst.stat().st_mode | 0o111)
            except Exception:
                pass
            restored.append(rel)

    return restored

def repair():
    init()
    h = health()

    repaired = []
    warnings = []

    if not h["checks"].get("redis_ping"):
        if start_redis():
            repaired.append("redis_started")
        else:
            warnings.append("redis_failed_to_start")

    for f in WATCH_FILES:
        p = ROOT / f
        if p.exists():
            try:
                p.chmod(p.stat().st_mode | 0o111)
            except Exception:
                pass

    restored = restore_missing_from_snapshot()
    repaired += ["restored:" + x for x in restored]

    commands = [
        ["bash", "cybra_redis_committee.sh", "ensure"],
        ["bin/cybra-finance-bin", "report"],
        ["bash", "kybra_valid.sh", "report"],
        ["bash", "cybra_payment_requisites.sh", "report"],
        ["bash", "cybra_finance_committees.sh", "report"],
        ["bash", "cybra_market_proof_collector.sh", "collect"],
        ["bash", "cybra_real_market_price_gate.sh", "status"],
        ["bash", "cybra_kibra_stats.sh", "report"]
    ]

    for cmd in commands:
        if (ROOT / cmd[0]).exists() or shutil.which(cmd[0]):
            code, out, err = run(cmd, timeout=90)
            if code == 0:
                repaired.append("ran:" + " ".join(cmd))
            else:
                warnings.append("failed:" + " ".join(cmd))

    repair_obj = {
        "status": "repair_completed",
        "time": time.time(),
        "time_iso": now_iso(),
        "repaired": repaired,
        "warnings": warnings,
        "health_before": h,
        "real_payment_now": False,
        "automatic_external_tx": False,
        "manual_OWNER_approval_required": True
    }
    repair_obj["double_sha"] = dsha(json.dumps(repair_obj, ensure_ascii=False, sort_keys=True))

    save_json("data/cybra_autoheal_7lvl/repair/latest_repair.json", repair_obj)
    redis_lpush(AUDIT, {
        "status": "repair_completed",
        "repaired": repaired,
        "warnings": warnings,
        "double_sha": repair_obj["double_sha"],
        "time": repair_obj["time"]
    })

    print("✅ repair completed")
    print("REPAIRED:", len(repaired))
    print("WARNINGS:", len(warnings))
    print("DOUBLE_SHA:", repair_obj["double_sha"])

def seal():
    init()
    h = health()

    manifest = {
        "status": "sealed",
        "time": time.time(),
        "time_iso": now_iso(),
        "alpha_sha": file_sha("data/cybra_autoheal_7lvl/alpha/system.json"),
        "beta_sha": file_sha("data/cybra_autoheal_7lvl/beta/system.json"),
        "dispatcher_sha": file_sha("data/cybra_autoheal_7lvl/dispatcher/system.json"),
        "health_sha": h.get("double_sha"),
        "watch_files": {f: file_sha(f) for f in WATCH_FILES},
        "levels": LEVELS,
        "rules": {
            "repair_alpha_beta": True,
            "sealed_levels": 7,
            "task_distribution": True,
            "no_private_keys": True,
            "no_seed_phrase": True,
            "no_automatic_real_payment": True,
            "owner_approval_required": True
        }
    }
    manifest["double_sha"] = dsha(json.dumps(manifest, ensure_ascii=False, sort_keys=True))

    save_json("data/cybra_autoheal_7lvl/seal/seal_manifest.json", manifest)
    redis_lpush(SEAL_Q, manifest)
    redis_lpush(AUDIT, {
        "status": "seal_created",
        "double_sha": manifest["double_sha"],
        "time": manifest["time"]
    })

    return manifest

def dispatch():
    init()
    h = health()
    s = seal()

    tasks = []
    for level in h["levels"]:
        task = {
            "topic": "CYBRA AutoHeal 7LVL task distribution",
            "type": "cybra_autoheal_7lvl_task",
            "priority": "critical" if not level["ok"] else "normal",
            "payload": {
                "source": "cybra_autoheal_7lvl",
                "level": level["level"],
                "level_name": level["name"],
                "ok": level["ok"],
                "bad": level["bad"],
                "seal_sha": s["double_sha"],
                "repair_alpha_beta": True,
                "convert_to_mining_block_first": True,
                "send_to_pool_mining": True,
                "real_payment_now": False,
                "automatic_external_tx": False,
                "manual_OWNER_approval_required": True
            }
        }
        task["double_sha"] = dsha(json.dumps(task, ensure_ascii=False, sort_keys=True))
        tasks.append(task)

    master = {
        "topic": "CYBRA AutoHeal Alpha/Beta sealed repair cycle",
        "type": "cybra_autoheal_7lvl_task",
        "priority": "critical",
        "payload": {
            "source": "cybra_autoheal_7lvl",
            "goal": "Alpha repairs Beta, Beta repairs Alpha, Seal Dispatcher distributes repair tasks through mining blocks.",
            "levels": 7,
            "seal_sha": s["double_sha"],
            "health_ok": h["ok"],
            "convert_to_mining_block_first": True,
            "send_to_pool_mining": True,
            "real_payment_now": False,
            "automatic_external_tx": False,
            "manual_OWNER_approval_required": True
        }
    }
    master["double_sha"] = dsha(json.dumps(master, ensure_ascii=False, sort_keys=True))
    tasks.append(master)

    for t in tasks:
        redis_lpush(AI_BLOCK_INBOX, t)
        redis_lpush(REPAIR_Q, t)

    save_json("data/cybra_autoheal_7lvl/tasks/latest_dispatched_tasks.json", {
        "tasks": tasks,
        "count": len(tasks),
        "time": time.time(),
        "time_iso": now_iso()
    })

    print("✅ tasks dispatched")
    print("TASKS:", len(tasks))
    print("SEAL:", s["double_sha"])

def mine():
    if exists("cybra_closed_sha_bridge.sh"):
        subprocess.run(["bash", "cybra_closed_sha_bridge.sh", "cycle"], cwd=ROOT)
    elif exists("cybra_ai_block_enforcer.sh"):
        subprocess.run(["bash", "cybra_ai_block_enforcer.sh", "enforce", "7"], cwd=ROOT)
    else:
        print("No closed SHA bridge / AI enforcer found")

def report():
    init()
    h = health()
    s = seal()

    package = {
        "status": "cybra_autoheal_7lvl_report_generated",
        "time": time.time(),
        "time_iso": now_iso(),
        "systems": {
            "alpha": load_json("data/cybra_autoheal_7lvl/alpha/system.json", {}),
            "beta": load_json("data/cybra_autoheal_7lvl/beta/system.json", {}),
            "dispatcher": load_json("data/cybra_autoheal_7lvl/dispatcher/system.json", {})
        },
        "levels": LEVELS,
        "health": h,
        "seal": s,
        "queues": {
            "audit": redis_len(AUDIT),
            "repair_queue": redis_len(REPAIR_Q),
            "seal_queue": redis_len(SEAL_Q),
            "block_inbox": redis_len(AI_BLOCK_INBOX),
            "task_block_mempool": redis_len("cybra:kibra:task_blocks:mempool"),
            "pool_mining_blocks": redis_len("cybra:kibra:pool:mining_blocks"),
            "parliament_queue": redis_len("cybra:parliament:queue"),
            "parliament_failed": redis_len("cybra:parliament:failed")
        },
        "safety": {
            "private_keys": False,
            "seed_phrase": False,
            "automatic_real_payment": False,
            "automatic_external_tx": False,
            "manual_OWNER_approval_required": True
        }
    }
    package["double_sha"] = dsha(json.dumps(package, ensure_ascii=False, sort_keys=True))

    save_json("feeds/cybra_autoheal_7lvl_report.json", package)
    save_json("data/cybra_autoheal_7lvl/reports/latest_report.json", package)

    lines = []
    lines.append("# CYBRA AutoHeal 7 Sealed Levels")
    lines.append("")
    lines.append("Status: active")
    lines.append("")
    lines.append("## Systems")
    lines.append("AUTOHEAL_ALPHA repairs AUTOHEAL_BETA")
    lines.append("AUTOHEAL_BETA repairs AUTOHEAL_ALPHA")
    lines.append("SEAL_DISPATCHER distributes tasks")
    lines.append("")
    lines.append("## Levels")
    for level in h["levels"]:
        lines.append(f"{level['level']}: ok={level['ok']} bad={level['bad']}")
    lines.append("")
    lines.append("## Queues")
    for k, v in package["queues"].items():
        lines.append(f"{k}: {v}")
    lines.append("")
    lines.append("## Seal")
    lines.append(s["double_sha"])
    lines.append("")
    lines.append("## Safety")
    lines.append("private_keys: false")
    lines.append("seed_phrase: false")
    lines.append("automatic_real_payment: false")
    lines.append("automatic_external_tx: false")
    lines.append("OWNER approval required: true")
    lines.append("")
    lines.append("## Double SHA")
    lines.append(package["double_sha"])

    (ROOT / "posts/cybra_autoheal_7lvl_report.md").write_text("\n".join(lines), encoding="utf-8")

    with (ROOT / "proofs/cybra_autoheal_7lvl.sha256").open("w") as f:
        subprocess.run([
            "sha256sum",
            "feeds/cybra_autoheal_7lvl_report.json",
            "posts/cybra_autoheal_7lvl_report.md",
            "data/cybra_autoheal_7lvl/seal/seal_manifest.json"
        ], cwd=ROOT, stdout=f, stderr=subprocess.DEVNULL)

    redis_lpush(AUDIT, {
        "status": "report_generated",
        "double_sha": package["double_sha"],
        "seal_sha": s["double_sha"],
        "time": package["time"]
    })

    print("✅ AutoHeal 7LVL report generated")
    print("HEALTH_OK:", h["ok"])
    print("SEAL:", s["double_sha"])
    print("REPORT: posts/cybra_autoheal_7lvl_report.md")
    print("PROOF: proofs/cybra_autoheal_7lvl.sha256")

def cycle():
    init()
    snapshot()
    repair()
    dispatch()
    mine()
    report()

def status():
    h = health()
    print("AUTOHEAL_7LVL:", "active")
    print("HEALTH_OK:", h["ok"])
    print("REDIS:", h["checks"].get("redis_ping"))
    print("LEVELS:", len(h["levels"]))
    print("REPAIR_QUEUE:", redis_len(REPAIR_Q))
    print("SEAL_QUEUE:", redis_len(SEAL_Q))
    print("BLOCK_INBOX:", redis_len(AI_BLOCK_INBOX))
    print("POOL_MINING_BLOCKS:", redis_len("cybra:kibra:pool:mining_blocks"))
    print("PARLIAMENT_FAILED:", redis_len("cybra:parliament:failed"))
    for x in h["levels"]:
        print(x["level"] + ":", x["ok"], x["bad"])

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"

    if cmd == "init":
        init()
        report()
    elif cmd == "status":
        status()
    elif cmd == "health":
        print(json.dumps(health(), ensure_ascii=False, indent=2))
    elif cmd == "snapshot":
        snapshot()
    elif cmd == "repair":
        repair()
    elif cmd == "seal":
        print(json.dumps(seal(), ensure_ascii=False, indent=2))
    elif cmd == "dispatch":
        dispatch()
    elif cmd == "mine":
        mine()
    elif cmd == "report":
        report()
    elif cmd == "cycle":
        cycle()
    else:
        raise SystemExit("Usage: init|status|health|snapshot|repair|seal|dispatch|mine|report|cycle")

if __name__ == "__main__":
    main()
