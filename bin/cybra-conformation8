        "modules": MODULES,
        "state": state,
        "tester": test,
        "simulator": sim,
        "fixer": fix,
        "solver": sol,
        "queue_manager": queue,
        "queues": {
            "audit": rlen(AUDIT),
            "issues": rlen(ISSUES_Q),
            "fix_queue": rlen(FIX_Q),
            "solutions": rlen(SOLUTIONS_Q),
            "ai_block_inbox": rlen(AI_BLOCK_INBOX),
            "parliament_queue": rlen(PARLIAMENT_QUEUE),
            "parliament_failed": rlen("cybra:parliament:failed"),
            "pool_mining_blocks": rlen("cybra:kibra:pool:mining_blocks")
        },
        "safety": {
            "private_keys": False,
            "seed_phrase": False,
            "automatic_real_payment": False,
            "automatic_SWIFT": False,
            "automatic_external_tx": False,
            "manual_OWNER_approval_required": True
        }
    }
    package["double_sha"] = dsha(json.dumps(package, ensure_ascii=False, sort_keys=True))

    save_json("feeds/cybra_conformation8_report.json", package)
    save_json("data/cybra_conformation8/reports/latest_report.json", package)

    lines = []
    lines.append("# CYBRA Conformation Eight Report")
    lines.append("")
    lines.append("Status: active")
    lines.append("")
    lines.append("## Five modules")
    for m in MODULES:
        lines.append(f"- {m['name']} / {m['role']}: {m['mission']}")
    lines.append("")
    lines.append("## State")
    lines.append(f"Redis: {state['modules']['redis']}")
    lines.append(f"AutoHeal: {state['modules']['autoheal']}")
    lines.append(f"Security Analytics: {state['modules']['security_analytics']}")
    lines.append(f"Cold Finance: {state['modules']['cold_finance']}")
    lines.append(f"KYBRA Valid: {state['modules']['kybra_valid']}")
    lines.append("")
    lines.append("## Blocks")
    for k, v in state["blocks"].items():
        lines.append(f"{k}: {v}")
    lines.append("")
    lines.append("## Queues")
    for k, v in package["queues"].items():
        lines.append(f"{k}: {v}")
    lines.append("")
    lines.append("## Missing / Issues")
    issues = test.get("issues", [])
    if issues:
        for i in issues:
            lines.append(f"- {i.get('severity')} / {i.get('type')}: {i.get('message')}")
    else:
        lines.append("None")
    lines.append("")
    lines.append("## Safety")
    for k, v in package["safety"].items():
        lines.append(f"{k}: {v}")
    lines.append("")
    lines.append("## Double SHA")
    lines.append(package["double_sha"])

    (ROOT / "posts/cybra_conformation8_report.md").write_text("\n".join(lines), encoding="utf-8")

    with (ROOT / "proofs/cybra_conformation8.sha256").open("w") as f:
        subprocess.run([
            "sha256sum",
            "feeds/cybra_conformation8_report.json",
            "posts/cybra_conformation8_report.md",
            "data/cybra_conformation8/reports/latest_report.json"
        ], cwd=ROOT, stdout=f, stderr=subprocess.DEVNULL)

    rpush(AUDIT, {
        "status": "report_generated",
        "double_sha": package["double_sha"],
        "time": package["time"]
    })

    print("✅ conformation8 report generated")
    print("REPORT: posts/cybra_conformation8_report.md")
    print("PROOF: proofs/cybra_conformation8.sha256")

def cycle():
    init()
    tester()
    simulator()
    fixer()
    solver()
    queue_manager()
    mine()
    tester()
    report()

def status():
    state = system_state()
    latest = load_json("feeds/cybra_conformation8_report.json", {})
    print("CONFORMATION8:", "active")
    print("REDIS:", state["modules"]["redis"])
    print("MAIN_BLOCKS:", state["blocks"]["main_blocks"])
    print("TASK_BLOCKS:", state["blocks"]["task_blocks"])
    print("EST_KIBRA:", state["blocks"]["estimated_kibra_default_reward_100"])
    print("AI_BLOCK_INBOX:", state["queues"]["ai_block_inbox"])
    print("PARLIAMENT_QUEUE:", state["queues"]["parliament_queue"])
    print("PARLIAMENT_FAILED:", state["queues"]["parliament_failed"])
    print("POOL_MINING_BLOCKS:", state["queues"]["pool_mining_blocks"])
    print("PAYMENT_READY:", state["readiness"]["payment_ready"])
    print("REAL_MARKET_CONFIRMED:", state["readiness"]["real_market_confirmed"])
    print("REPORT_EXISTS:", bool(latest))
    print("AUDIT:", rlen(AUDIT))
    print("ISSUES:", rlen(ISSUES_Q))
    print("SOLUTIONS:", rlen(SOLUTIONS_Q))

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"

    if cmd == "init":
        init()
        report()
    elif cmd == "test":
        tester()
    elif cmd == "simulate":
        simulator()
    elif cmd == "fix":
        fixer()
    elif cmd == "solve":
        solver()
    elif cmd == "queue":
        queue_manager()
    elif cmd == "mine":
        mine()
    elif cmd == "report":
        report()
    elif cmd == "cycle":
        cycle()
    elif cmd == "status":
        status()
    else:
        raise SystemExit("Usage: init|status|test|simulate|fix|solve|queue|mine|report|cycle")

if __name__ == "__main__":
    main()
