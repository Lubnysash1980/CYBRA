#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════════════════
# CYBRA ENFORCE — 3% deviation policy:
#   • within 3%      → REWARD (лог + відмітка)
#   • beyond 3%      → BLOCKED + AUTO-RESTORE до 100%
#   • improvement    → OK (без обмежень)
# ═══════════════════════════════════════════════════════════

ROOT="$HOME/CYBRA"
MODULES="$ROOT/modules"
BASELINE="$ROOT/baseline"
EVO_DIR="$ROOT/evolution"
AUDIT="$ROOT/audit"
LOGS="$ROOT/logs"
M35="$MODULES/module_35_cybra_guardian"

REWARD_LOG="$EVO_DIR/reward.log"
BLOCKED_LOG="$EVO_DIR/blocked.log"
LEDGER="$EVO_DIR/evolution_ledger.txt"

mkdir -p "$EVO_DIR" "$LOGS"

if [ -t 1 ]; then
    R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'
    B=$'\033[1m'; C=$'\033[36m'; M=$'\033[35m'
    Z=$'\033[0m'; GR=$'\033[90m'
else
    R=""; G=""; Y=""; B=""; C=""; M=""; Z=""; GR=""
fi

hr()  { printf -- '────────────────────────────────────────────────────────────\n'; }
hdr() { printf '\n%s%s═══ %s ═══%s\n' "$B" "$C" "$*" "$Z"; }
ok()   { printf '  %s[✓]%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '  %s[!]%s %s\n' "$Y" "$Z" "$*"; }
err()  { printf '  %s[✗]%s %s\n' "$R" "$Z" "$*"; }
rew()  { printf '  %s[🎁]%s %s\n' "$M" "$Z" "$*"; }

log_evo()     { printf '%s | %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LEDGER"; }
log_blocked() { printf '%s | %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$BLOCKED_LOG"; }
log_reward()  { printf '%s | %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$REWARD_LOG"; }

# ─── 3% формула (строга) ───
pct_status() {
    local old="$1" new="$2" tol="${3:-3}"

    old="$(printf '%s' "$old" | head -1 | tr -dc '0-9')"
    new="$(printf '%s' "$new" | head -1 | tr -dc '0-9')"
    [ -z "$old" ] && old=0
    [ -z "$new" ] && new=0

    # 0 → 0
    if [ "$old" -eq 0 ] && [ "$new" -eq 0 ]; then echo "OK"; return; fi
    # 0 → щось
    if [ "$old" -eq 0 ]; then echo "BLOCKED"; return; fi
    # Рівність
    [ "$new" -eq "$old" ] && { echo "OK"; return; }

    # Покращення
    [ "$new" -gt "$old" ] && { echo "IMPROVE"; return; }
    # Деградація — 3%
    local lost=$(( old - new ))
    local allowed=$(( old * tol / 100 ))
    [ "$lost" -le "$allowed" ] && { echo "TOLERANCE"; return; }
    echo "BLOCKED"
}

# ═══════════════════════════════════════════════════════════
# Метрики модуля (pass/fail з test log)
# ═══════════════════════════════════════════════════════════
module_metrics() {
    local m="$1"
    local tlog="$(ls -t "$AUDIT"/*_"${m}".test.log 2>/dev/null | head -1)"

    local pass=0 fail=0

    if [ -f "$tlog" ]; then
        # ─── Формат 1: [PASS] / [FAIL] per-line ───
        pass="$(grep -c '\[PASS\]' "$tlog" 2>/dev/null | head -1 | tr -dc '0-9')"
        fail="$(grep -c '\[FAIL\]' "$tlog" 2>/dev/null | head -1 | tr -dc '0-9')"
        [ -z "$pass" ] && pass=0
        [ -z "$fail" ] && fail=0

        # ─── Формат 2: PASS=N / FAIL=N (summary) ───
        if [ "$pass" -eq 0 ] && [ "$fail" -eq 0 ]; then
            local p2="$(grep -oE 'PASS=[0-9]+' "$tlog" 2>/dev/null | tail -1 | cut -d= -f2)"
            local f2="$(grep -oE 'FAIL=[0-9]+' "$tlog" 2>/dev/null | tail -1 | cut -d= -f2)"
            [ -n "$p2" ] && pass="$p2"
            [ -n "$f2" ] && fail="$f2"
        fi

        # ─── Формат 3: PASS: N / FAIL: N ───
        if [ "$pass" -eq 0 ] && [ "$fail" -eq 0 ]; then
            local p3="$(grep -oE 'PASS:[[:space:]]*[0-9]+' "$tlog" 2>/dev/null | tail -1 | grep -oE '[0-9]+')"
            local f3="$(grep -oE 'FAIL:[[:space:]]*[0-9]+' "$tlog" 2>/dev/null | tail -1 | grep -oE '[0-9]+')"
            [ -n "$p3" ] && pass="$p3"
            [ -n "$f3" ] && fail="$f3"
        fi
    fi

    [ -z "$pass" ] && pass=0
    [ -z "$fail" ] && fail=0

    local bp="$(cat "$BASELINE/${m}.pass" 2>/dev/null | tr -dc '0-9')"
    local bf="$(cat "$BASELINE/${m}.fail" 2>/dev/null | tr -dc '0-9')"
    [ -z "$bp" ] && bp=0
    [ -z "$bf" ] && bf=0

    printf '%s %s %s %s' "$bp" "$bf" "$pass" "$fail"
}

# ═══════════════════════════════════════════════════════════
# AUTO-RESTORE до 100%
# ═══════════════════════════════════════════════════════════
restore_module() {
    local m="$1"
    local mod="$MODULES/$m"

    # 0. Тест існує?
    if [ ! -x "$mod/tests/run_tests.sh" ]; then
        printf '      %s[SKIP]%s немає тесту\n' "$Y" "$Z"
        return 1
    fi

    # 1. ВИДАЛЯЄМО FROZEN.env — це маркер який блокує тест
    rm -f "$mod/tests/FROZEN.env" "$mod/tests/FROZEN" 2>/dev/null
    printf '      → removed FROZEN marker\n'

    # 2. Snapshot restore — ТІЛЬКИ bin/, state/, rules/, не tests/
    local snap=""
    for s in "$mod/snapshot" "$mod/snapshots"; do
        [ -d "$s" ] && { snap="$s"; break; }
    done

    if [ -n "$snap" ]; then
        for sub in bin state rules; do
            [ ! -d "$snap" ] && continue
            for f in "$snap"/*; do
                [ -f "$f" ] || continue
                local name="$(basename "$f")"
                # копіюємо тільки .sh та .env у відповідні підпапки
                case "$name" in
                    *.sh)  [ -d "$mod/bin" ] && cp "$f" "$mod/bin/$name" 2>/dev/null && printf '      → %s → bin/%s\n' "$(basename "$f")" "$name" ;;
                    *.env) [ -d "$mod/state" ] && cp "$f" "$mod/state/$name" 2>/dev/null && printf '      → %s → state/%s\n' "$(basename "$f")" "$name" ;;
                esac
            done
        done
    fi

    # 3. Git restore — тільки bin/, state/, rules/ (НЕ tests/)
    local gitmod="$ROOT/git_module/modules/$m"
    if [ -d "$gitmod" ]; then
        for sub in bin state rules; do
            [ -d "$gitmod/$sub" ] || continue
            [ -d "$mod/$sub" ] || mkdir -p "$mod/$sub"
            cp -r "$gitmod/$sub"/* "$mod/$sub/" 2>/dev/null && \
                printf '      → git → %s/\n' "$sub"
        done
    fi

    # 4. Запуск тесту — БЕЗ baseline updates
    printf '      → re-run tests...\n'
    if (cd "$mod" && ./tests/run_tests.sh > "$LOGS/restore_${m}.log" 2>&1); then
        local np="$(grep -c '\[PASS\]' "$LOGS/restore_${m}.log" 2>/dev/null | head -1 | tr -dc '0-9')"
        [ -z "$np" ] && np=0
        printf '      %s✓ pass=%s%s\n' "$G" "$np" "$Z"

        # 5. ТІЛЬКИ ТЕПЕР — re-seal baseline під відновлений стан
        #    але ТІЛЬКИ якщо np >= baseline (не знижуємо планку)
        local bp="$(cat "$BASELINE/${m}.pass" 2>/dev/null | tr -dc '0-9')"
        [ -z "$bp" ] && bp=0
        if [ "$np" -ge "$bp" ]; then
            printf '%s' "$np" > "$BASELINE/${m}.pass"
            printf '%s' "$(grep -c '\[FAIL\]' "$LOGS/restore_${m}.log" 2>/dev/null | head -1 | tr -dc '0-9')" > "$BASELINE/${m}.fail"
            local h="$(hash_tree "$mod")"
            printf '%s' "$h" > "$BASELINE/${m}.tree"
            printf '%s' "$h" > "$EVO_DIR/${m}.approved"
            printf '      → baseline updated: pass=%s (was %s)\n' "$np" "$bp"
        else
            printf '      %s✗ pass=%s < baseline=%s — НЕ оновлюю baseline%s\n' "$R" "$np" "$bp" "$Z"
            return 1
        fi
        return 0
    else
        printf '      %s✗ тест все ще падає — manual fix needed%s\n' "$R" "$Z"
        tail -5 "$LOGS/restore_${m}.log" 2>/dev/null | sed 's/^/        /'
        return 1
    fi
}

hash_tree() {
    local d="$1"
    ( cd "$d" 2>/dev/null || return
      find . -type f \
        ! -name '*.log' ! -name '*.test.log' \
        ! -name 'test_output.txt' ! -name 'test_output.sha256' \
        ! -name 'SNAPSHOT_SHA256.txt' ! -name '*.bak.*' \
        -print0 2>/dev/null |
      sort -z | xargs -0 -r sha256sum 2>/dev/null |
      sha256sum | awk '{print $1}' )
}

# ═══════════════════════════════════════════════════════════
# ENFORCE — головна функція
# ═══════════════════════════════════════════════════════════
enforce_all() {
    hdr "CYBRA ENFORCE — 3% policy"
    printf '  Policy:  ≤ 3%%  → 🎁 REWARD\n'
    printf '           > 3%%  → 🔴 BLOCKED + auto-restore\n'
    printf '           +any  → 🟢 IMPROVE (завжди OK)\n'
    hr

    local total=0 stable=0 improved=0 rewarded=0 blocked=0

    for d in "$MODULES"/*/; do
        [ -d "$d" ] || continue
        local m="$(basename "$d")"
        case "$m" in @*|.*|_disabled*|evolution|answer_engine|node_modules) continue ;; esac
        total=$((total+1))

        read -r bp bf pass fail <<< "$(module_metrics "$m")"

        local st_pass="$(pct_status "$bp" "$pass" 3)"
        local st_fail="OK"
        if [ "$fail" -gt "$bf" ]; then st_fail="BLOCKED"; fi

        # ─── OK (рівність) ───
        if [ "$st_pass" = "OK" ] && [ "$st_fail" = "OK" ]; then
            printf '  %s[⚪ OK]%s     %-42s pass %s→%s\n' \
                "$GR" "$Z" "$m" "$bp" "$pass"
            stable=$((stable+1))
            continue
        fi

        # ─── IMPROVE (покращення) ───
        if [ "$st_pass" = "IMPROVE" ] && [ "$st_fail" = "OK" ]; then
            printf '  %s[🟢 IMPROVE]%s %-42s pass %s→%s (+%s)\n' \
                "$G" "$Z" "$m" "$bp" "$pass" "$(( pass - bp ))"
            log_evo "IMPROVE: $m pass $bp→$pass"
            improved=$((improved+1))
            printf '%s' "$pass" > "$BASELINE/${m}.pass"
            printf '%s' "$fail" > "$BASELINE/${m}.fail"
            continue
        fi

        # ─── TOLERANCE ≤ 3% ───
        if [ "$st_pass" = "TOLERANCE" ] && [ "$st_fail" = "OK" ]; then
            local lost=$(( bp - pass ))
            local allowed=$(( bp * 3 / 100 ))
            printf '  %s[🎁 REWARD]%s %-42s pass %s→%s (lost %s ≤ %s)\n' \
                "$M" "$Z" "$m" "$bp" "$pass" "$lost" "$allowed"
            log_reward "TOLERANCE_OK: $m lost $lost (allowed $allowed)"
            log_evo    "OK_TOLERANCE: $m pass $bp→$pass"
            rewarded=$((rewarded+1))
            # Оновлюємо baseline (нова норма в межах 3%)
            printf '%s' "$pass" > "$BASELINE/${m}.pass"
            printf '%s' "$fail" > "$BASELINE/${m}.fail"
            continue
        fi

        # ─── ПЕРЕВІРКА: чи тест взагалі існує ───
        local tests="$MODULES/$m/tests/run_tests.sh"
        if [ ! -x "$tests" ]; then
            printf '  %s[⚪ NO-TEST]%s %-42s pass %s→%s\n'                 "$GR" "$Z" "$m" "$bp" "$pass"
            continue
        fi

        # ─── BLOCKED > 3% або FAIL зріс ───
        if [ "$st_pass" = "BLOCKED" ] || [ "$st_fail" = "BLOCKED" ]; then
            printf '  %s[🔴 BLOCKED]%s %-42s' "$R" "$Z" "$m"
            if [ "$st_pass" = "BLOCKED" ]; then
                local lost=$(( bp - pass ))
                local allowed=$(( bp * 3 / 100 ))
                printf ' pass %s→%s (lost %s > %s)' "$bp" "$pass" "$lost" "$allowed"
            fi
            [ "$st_fail" = "BLOCKED" ] && printf ' fail %s→%s' "$bf" "$fail"
            printf '\n'

            log_blocked "DEGRADATION: $m pass $bp→$pass fail $bf→$fail"
            log_evo     "BLOCKED: $m"

            # ─── AUTO-RESTORE ───
            printf '      %sRestore...%s\n' "$Y" "$Z"
            restore_module "$m"

            # Re-run test
            local tests="$MODULES/$m/tests/run_tests.sh"
            if [ -x "$tests" ]; then
                if "$tests" > "$LOGS/restore_${m}.log" 2>&1; then
                    local new_pass="$(grep -c '\[PASS\]' "$LOGS/restore_${m}.log" 2>/dev/null | head -1 | tr -dc '0-9')"
                    [ -z "$new_pass" ] && new_pass=0
                    printf '      %s✓ restored — pass=%s%s\n' "$G" "$new_pass" "$Z"
                else
                    printf '      %s✗ restore failed — manual check%s\n' "$R" "$Z"
                fi
            fi

            blocked=$((blocked+1))
            continue
        fi

        # ─── OK ───
        printf '  %s[⚪ OK]%s     %-42s pass %s→%s\n' \
            "$GR" "$Z" "$m" "$bp" "$pass"
    done

    hr
    printf '\n'
    printf '  %s╔══════════════════════════════════════════════════╗%s\n' "$B" "$Z"
    printf '  %s║  ENFORCE RESULT                                  ║%s\n' "$B" "$Z"
    printf '  %s╚══════════════════════════════════════════════════╝%s\n' "$B" "$Z"
    printf '\n'
    printf '  Модулів:          %s\n' "$total"
    printf '  %sStable:           %s%s\n' "$GR" "$stable" "$Z"
    printf '  %sImprove:          %s%s\n' "$G" "$improved" "$Z"
    printf '  %sReward ≤ 3%%:       %s%s\n' "$M" "$rewarded" "$Z"
    printf '  %sBlocked > 3%%:      %s%s\n' "$R" "$blocked" "$Z"
    printf '\n'

    if [ "$blocked" -eq 0 ]; then
        printf '  %s✓ СИСТЕМА 100%% — усі модулі в нормі%s\n' "$G" "$Z"
    else
        printf '  %s✗ Відновлено: %s модулів (перевір логи)%s\n' "$Y" "$blocked" "$Z"
    fi
    printf '\n  Ledger:  %s\n' "$LEDGER"
    printf '  Blocked: %s\n' "$BLOCKED_LOG"
    printf '  Reward:  %s\n' "$REWARD_LOG"
    printf '\n'

    [ "$blocked" -eq 0 ] && return 0 || return 1
}

# ═══════════════════════════════════════════════════════════
# TEST — симуляція деградації
# ═══════════════════════════════════════════════════════════
enforce_test() {
    hdr "ENFORCE — симуляція деградації"

    local test_mod="module_01_auto_executor"
    [ ! -d "$MODULES/$test_mod" ] && { err "$test_mod не знайдено"; return 1; }

    # Зберігаємо оригінал
    local orig_pass="$(cat "$BASELINE/${test_mod}.pass" 2>/dev/null || echo 0)"
    local orig_fail="$(cat "$BASELINE/${test_mod}.fail" 2>/dev/null || echo 0)"
    local orig_tree="$(cat "$BASELINE/${test_mod}.tree" 2>/dev/null || echo NONE)"

    printf '  Baseline: pass=%s fail=%s\n' "$orig_pass" "$orig_fail"

    # Симуляція 1: 4% деградація (BLOCKED)
    printf '\n  %sСимуляція 1: 4%% деградація%s\n' "$Y" "$Z"
    printf '%s' "$(( orig_pass * 96 / 100 ))" > "$BASELINE/${test_mod}.pass"
    printf '%s' "$orig_fail" > "$BASELINE/${test_mod}.fail"

    local st="$(pct_status "$orig_pass" "$(( orig_pass * 96 / 100 ))" 3)"
    printf '  pass: %s → %s  →  %s\n' "$orig_pass" "$(( orig_pass * 96 / 100 ))" "$st"
    [ "$st" = "BLOCKED" ] && ok "BLOCKED (правильно)" || err "не BLOCKED — баг"

    # Симуляція 2: межа (3% або >0 для малих чисел)
    local allowed=$(( orig_pass * 3 / 100 ))
    local step_ok=$(( orig_pass - allowed ))       # = межа 3%
    local step_bad=$(( orig_pass - allowed - 1 ))  # > 3%

    printf '\n  %sСимуляція 2: межа 3%% (pass=%s, allowed=%s)%s\n' "$Y" "$Z" "$orig_pass" "$allowed"
    st="$(pct_status "$orig_pass" "$step_ok" 3)"
    printf '  pass: %s → %s  →  %s\n' "$orig_pass" "$step_ok" "$st"
    if [ "$allowed" -eq 0 ]; then
        # При allowed=0 — очікуємо OK тільки якщо new == old
        [ "$st" = "OK" ] || [ "$st" = "IMPROVE" ] && ok "0 allowed → OK" || err "очікувалось OK при 0 allowed"
    else
        [ "$st" = "TOLERANCE" ] && ok "TOLERANCE → REWARD" || err "не TOLERANCE — баг"
    fi

    # Симуляція 2b: > 3% (allowed=0 → будь-яка втрата BLOCKED)
    printf '\n  %sСимуляція 2b: > 3%%%s\n' "$Y" "$Z"
    st="$(pct_status "$orig_pass" "$step_bad" 3)"
    printf '  pass: %s → %s  →  %s\n' "$orig_pass" "$step_bad" "$st"
    if [ "$allowed" -eq 0 ]; then
        # allowed=0 → втрата 1 = BLOCKED
        [ "$st" = "BLOCKED" ] && ok "0 allowed → BLOCKED при втраті 1" || err "очікувалось BLOCKED"
    else
        [ "$st" = "BLOCKED" ] && ok "BLOCKED (правильно)" || err "не BLOCKED — баг"
    fi

    # Симуляція 3: покращення (IMPROVE)
    printf '\n  %sСимуляція 3: покращення%s\n' "$Y" "$Z"
    st="$(pct_status "$orig_pass" "$(( orig_pass + 10 ))" 3)"
    printf '  pass: %s → %s  →  %s\n' "$orig_pass" "$(( orig_pass + 10 ))" "$st"
    [ "$st" = "IMPROVE" ] && ok "IMPROVE (завжди OK)" || err "не IMPROVE — баг"

    # Відкат
    printf '\n  %sВідкат baseline%s\n' "$C" "$Z"
    printf '%s' "$orig_pass" > "$BASELINE/${test_mod}.pass"
    printf '%s' "$orig_fail" > "$BASELINE/${test_mod}.fail"
    printf '%s' "$orig_tree" > "$BASELINE/${test_mod}.tree"
    ok "baseline відновлено"
}

# ═══════════════════════════════════════════════════════════
# МENU
# ═══════════════════════════════════════════════════════════
show_menu() {
    clear 2>/dev/null
    printf '%s%s═══ CYBRA ENFORCE ═══%s\n\n' "$B" "$M" "$Z"
    printf '  %s[1]%s Enforce all (3%% policy)\n'  "$B$G" "$Z"
    printf '  %s[2]%s Test (симуляція)\n'          "$B" "$Z"
    printf '  %s[3]%s Reward log\n'                 "$B" "$Z"
    printf '  %s[4]%s Blocked log\n'                "$B" "$Z"
    printf '  %s[0]%s Вихід\n'                      "$B" "$Z"
    printf '\n  Вибір: '
}

case "${1:-menu}" in
    all|a|1|enforce)  enforce_all ;;
    test|t|2)         enforce_test ;;
    reward|r|3)       cat "$REWARD_LOG" 2>/dev/null || echo "(empty)" ;;
    blocked|b|4)      cat "$BLOCKED_LOG" 2>/dev/null || echo "(empty)" ;;
    menu|m|"")
        while true; do
            show_menu
            read -r c
            printf '\n'
            case "$c" in
                1) enforce_all ;;
                2) enforce_test ;;
                3) cat "$REWARD_LOG" 2>/dev/null || echo "(empty)" ;;
                4) cat "$BLOCKED_LOG" 2>/dev/null || echo "(empty)" ;;
                0|q|Q|exit) printf 'Вихід\n'; exit 0 ;;
                *) err "Невідома: $c" ;;
            esac
            printf '\n%sEnter...%s' "$GR" "$Z"
            read -r _
        done
        ;;
    *)
        printf 'Usage: cybra_enforce [all|test|reward|blocked|menu]\n'
        exit 1
        ;;
esac
