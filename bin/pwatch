#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════════════════
# CYBRA PARAWATCH — паралельний runtime watcher
# Працює у фоні, слідкує за станом системи
# ═══════════════════════════════════════════════════════════

ROOT="$HOME/CYBRA"
MODULES="$ROOT/modules"
BASELINE="$ROOT/baseline"
AUDIT="$ROOT/audit"
LOGS="$ROOT/logs"
PIDFILE="$ROOT/.parawatch.pid"
WATCHLOG="$LOGS/parawatch.log"
STATE="$ROOT/.parawatch.state"

mkdir -p "$LOGS"

# ─── Кольори ───
if [ -t 1 ]; then
    R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'
    B=$'\033[1m'; C=$'\033[36m'; Z=$'\033[0m'; GR=$'\033[90m'
else
    R=""; G=""; Y=""; B=""; C=""; Z=""; GR=""
fi

log() { printf '%s | %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$WATCHLOG"; }

# ─── Одна ітерація перевірки ───
one_check() {
    local stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    local issues=0
    local checked=0

    # 1. Перевірка модулів
    for d in "$MODULES"/*/; do
        [ -d "$d" ] || continue
        local m="$(basename "$d")"
        case "$m" in @*|.*|_disabled*|evolution|answer_engine|node_modules) continue ;; esac
        checked=$((checked+1))

        # Syntax check
        for f in "$d/bin"/*.sh "$d"/*.sh; do
            [ -f "$f" ] || continue
            if ! bash -n "$f" 2>/dev/null; then
                log "SYNTAX_ERROR: $m / $(basename "$f")"
                issues=$((issues+1))
            fi
        done
    done

    # 2. Перевірка git status
    if [ -d "$ROOT/git_module/.git" ]; then
        ( cd "$ROOT/git_module"
          local changes="$(git status --porcelain 2>/dev/null | wc -l)"
          [ "$changes" -gt 50 ] && log "GIT_DIRTY: $changes uncommitted"
        )
    fi

    # 3. Перевірка disk
    local size="$(du -sm "$ROOT" 2>/dev/null | cut -f1)"
    [ -n "$size" ] && [ "$size" -gt 5000 ] && log "DISK_WARN: ${size}MB"

    # 4. Оновлення state
    {
        printf 'LAST_CHECK=%s\n' "$stamp"
        printf 'MODULES_CHECKED=%s\n' "$checked"
        printf 'ISSUES=%s\n' "$issues"
    } > "$STATE"

    return $issues
}

# ═══════════════════════════════════════════════════════════
# START (background)
# ═══════════════════════════════════════════════════════════
start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        printf '  %s[!]%s parawatch вже запущено (PID %s)\n' "$Y" "$Z" "$(cat "$PIDFILE")"
        return 1
    fi

    printf '  %s→%s запуск parawatch у фоні...\n' "$C" "$Z"

    nohup bash -c '
        while true; do
            source "'"$0"'" 2>/dev/null
            one_check
            sleep 30
        done
    ' >> "$WATCHLOG" 2>&1 &

    echo $! > "$PIDFILE"
    printf '  %s[✓]%s parawatch PID=%s\n' "$G" "$Z" "$(cat "$PIDFILE")"
    log "STARTED pid=$(cat "$PIDFILE")"
}

# ═══════════════════════════════════════════════════════════
# STOP
# ═══════════════════════════════════════════════════════════
stop() {
    if [ ! -f "$PIDFILE" ]; then
        printf '  %s[!]%s parawatch не запущено\n' "$Y" "$Z"
        return 1
    fi

    local pid="$(cat "$PIDFILE")"
    if kill "$pid" 2>/dev/null; then
        printf '  %s[✓]%s parawatch зупинено (PID %s)\n' "$G" "$Z" "$pid"
        log "STOPPED pid=$pid"
    else
        printf '  %s[!]%s не знайдено процес PID %s\n' "$Y" "$Z" "$pid"
    fi
    rm -f "$PIDFILE"
}

# ═══════════════════════════════════════════════════════════
# STATUS
# ═══════════════════════════════════════════════════════════
status() {
    printf '%s%s═══ PARAWATCH STATUS ═══%s\n\n' "$B" "$C" "$Z"

    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        printf '  %s[✓] RUNNING%s (PID %s)\n' "$G" "$Z" "$(cat "$PIDFILE")"
    else
        printf '  %s[·] STOPPED%s\n' "$GR" "$Z"
    fi

    if [ -f "$STATE" ]; then
        printf '\n  Останній стан:\n'
        sed 's/^/    /' "$STATE"
    fi

    printf '\n  Останні 10 подій:\n'
    tail -10 "$WATCHLOG" 2>/dev/null | sed 's/^/    /' || printf '    (порожньо)\n'
    printf '\n'
}

# ═══════════════════════════════════════════════════════════
# ONCE
# ═══════════════════════════════════════════════════════════
once() {
    printf '%s%s═══ PARAWATCH (один прогін) ═══%s\n\n' "$B" "$C" "$Z"
    one_check
    printf '  Перевірено модулів: %s\n' "$(grep MODULES_CHECKED "$STATE" | cut -d= -f2)"
    printf '  Проблем: %s\n' "$(grep ISSUES "$STATE" | cut -d= -f2)"
}

case "${1:-status}" in
    start|s)   start ;;
    stop|S)    stop ;;
    restart|r) stop; sleep 1; start ;;
    status|st) status ;;
    once|o)    once ;;
    *)
        cat <<USAGE
Usage: cybra_parawatch [command]

  start     запустити у фоні (background)
  stop      зупинити
  restart   перезапустити
  status    статус + останні події
  once      один прогін перевірки

Працює паралельно з TUI (cybra). Інтервал: 30 сек.
Лог: $WATCHLOG
USAGE
        ;;
esac
